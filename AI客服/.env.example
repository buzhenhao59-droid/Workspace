# ================================================================
# Ruitalk 统一配置
# 将此文件复制为 .env，然后填入你的配置
# cp .env.example .env
# ================================================================
#
# 生产 / 交付候选：设置 RUITALK_ENV=production 时，卖方服务将拒绝启动，
# 除非已替换下列默认密钥与口令（见 config.enforce_production_security_or_exit）。
# 随机密钥生成示例：
#   openssl rand -hex 32
#   PowerShell: [Convert]::ToHexString([byte[]](1..32 | ForEach-Object { Get-Random -Max 256 }))
#
# ========== 运行环境 ==========
# development | production（生产务必改为 production 并轮换全部密钥）
RUITALK_ENV=development

# ========== 基础安全 ==========
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-key-change-in-production-please-change-it
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_PASSWORD=123456
ADMIN_PASSWORD_SALT=ruitalk-dev-salt-2026

# ========== DeepSeek AI ==========
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# ========== 数据库 (MySQL) ==========
# 开发模式不配置则使用 SQLite
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=ruitalk

# ========== 买方数据库 ==========
BUYER_MYSQL_HOST=
BUYER_MYSQL_PORT=3306
BUYER_MYSQL_USER=
BUYER_MYSQL_PASSWORD=
BUYER_MYSQL_DATABASE=ruitalk_buyer

# ========== Neo4j 图数据库 ==========
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ========== Redis (缓存/会话) ==========
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# 开发时可设为 true 使用内存模拟
REDIS_USE_FAKE=true

# ========== 服务端口 ==========
FASTAPI_PORT=8000
GOLD_CS_PORT=5001
GRAPHRAG_PROXY_PORT=5050
BUYER_PORT=8001

# ========== SMTP 邮件 ==========
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
SMTP_TLS=true
SMTP_FROM=noreply@example.com

# ========== 短信服务 (选一) ==========
# 演示模式：不用配置，控制台打印验证码
SMS_PROVIDER=demo

# 阿里云短信
# ALIYUN_ACCESS_KEY_ID=your_aliyun_key
# ALIYUN_ACCESS_KEY_SECRET=your_aliyun_secret
# ALIYUN_SMS_SIGN_NAME=Ruitalk
# ALIYUN_SMS_TEMPLATE_CODE=SMS_xxxxxxxxx

# 腾讯云短信
# TENCENT_SMS_APP_ID=your_tencent_appid
# TENCENT_SMS_APP_KEY=your_tencent_key
# TENCENT_SMS_SIGN_NAME=Ruitalk
# TENCENT_SMS_TEMPLATE_ID=your_template_id

# Twilio 国际短信
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_FROM_NUMBER=+1234567890

# ========== 跨境电商平台 API ==========

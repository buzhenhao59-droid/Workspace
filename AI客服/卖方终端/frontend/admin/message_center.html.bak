    <!-- 模态框：添加快捷回??-->
    <div class="modal-overlay hidden" id="quickReplyModal">
      <div class="modal">
        <div class="modal-header">
          <span class="modal-title" id="quickReplyModalTitle"
            >添加快捷回复</span
          >
          <button class="modal-close" onclick="closeQuickReplyModal()">
            &times;
          </button>
        </div>
        <div class="modal-body">
          <div class="form-group">
            <label class="form-label">分类</label>
            <select class="form-select" id="qrCategory">
              <option value="通用">通用</option>
              <option value="订单">订单</option>
              <option value="物流">物流</option>
              <option value="售后">售后</option>
              <option value="售前">售前</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">标题</label>
            <input
              type="text"
              class="form-input"
              id="qrTitle"
              placeholder="输入快捷回复标题"
            />
          </div>
          <div class="form-group">
            <label class="form-label">内容</label>
            <textarea
              class="form-textarea"
              id="qrContent"
              placeholder="输入快捷回复内容"
            ></textarea>
          </div>
          <div class="form-group">
            <label class="form-label">快捷指令（可选）</label>
            <input
              type="text"
              class="form-input"
              id="qrShortcut"
              placeholder="如：你好"
            />
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-ghost" onclick="closeQuickReplyModal()">
            取消
          </button>
          <button
            class="btn btn-primary"
            id="qrSaveBtn"
            onclick="saveQuickReply()"
          >
            保存
          </button>
        </div>
      </div>
    </div>

    <!-- 模态框：添加提??-->
    <div class="modal-overlay hidden" id="reminderModal">
      <div class="modal">
        <div class="modal-header">
          <span class="modal-title" id="reminderModalTitle">添加提醒</span>
          <button class="modal-close" onclick="closeReminderModal()">
            &times;
          </button>
        </div>
        <div class="modal-body">
          <div class="form-group">
            <label class="form-label">提醒标题</label>
            <input
              type="text"
              class="form-input"
              id="remTitle"
              placeholder="如：货物到达提醒"
            />
          </div>
          <div class="form-group">
            <label class="form-label">提醒内容</label>
            <textarea
              class="form-textarea"
              id="remContent"
              placeholder="输入提醒详情"
            ></textarea>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">提醒时间</label>
              <input type="datetime-local" class="form-input" id="remTime" />
            </div>
            <div class="form-group">
              <label class="form-label">提醒类型</label>
              <select class="form-select" id="remType">
                <option value="once">仅一??/option>
                <option value="daily">每天</option>
                <option value="weekly">每周</option>
              </select>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-ghost" onclick="closeReminderModal()">
            取消
          </button>
          <button
            class="btn btn-primary"
            id="remSaveBtn"
            onclick="saveReminder()"
          >
            保存
          </button>
        </div>
      </div>
    </div>

    <script>
    <script>
      console.log("=== MESSAGE CENTER LOADING ===");

      // Auth helpers
      function getAuthToken() {
        return localStorage.getItem("agent_access_token") || localStorage.getItem("admin_access_token");
      }

      // Safe fetch with auto token
      function safeFetch(url, options) {
        options = options || {};
        options.headers = Object.assign({}, options.headers);
        if (url && url.indexOf("/api/") === 0) {
          var token = getAuthToken();
          if (token && !options.headers["Authorization"]) {
            options.headers["Authorization"] = "Bearer " + token;
          }
        }
        return fetch(url, options).then(function(res) {
          if (res.status === 401) {
            localStorage.removeItem("admin_access_token");
            localStorage.removeItem("agent_access_token");
            alert("登录已过期，请重新登录");
            window.location.href = "/admin/login";
          }
          return res;
        });
      }

      // Fetch with timeout
      function fetchWithTimeout(url, options, ms) {
        ms = ms || 20000;
        var opts = Object.assign({}, options || {});
        if (url && url.indexOf("/api/") === 0) {
          var token = getAuthToken();
          if (token && !opts.headers) {
            opts.headers = { Authorization: "Bearer " + token };
          }
        }
        return new Promise(function(resolve, reject) {
          var timer = setTimeout(function() { reject(new Error("请求超时")); }, ms);
          fetch(url, opts).then(function(res) {
            clearTimeout(timer);
            resolve(res);
          }).catch(function(err) {
            clearTimeout(timer);
            reject(err);
          });
        });
      }

      // Global state
      var currentTab = "conversations";
      var currentPlatform = null;
      var currentCategory = null;

      // Tab switching
      function switchTab(tab) {
        currentTab = tab;
        document.querySelectorAll("#mcSubtabs .tab-btn").forEach(function(el) {
          el.classList.toggle("active", el.getAttribute("data-tab") === tab);
        });
        refreshCurrentTab();
      }

      function refreshCurrentTab() {
        switch (currentTab) {
          case "conversations": loadConversations(); break;
          case "quick-replies": loadQuickReplies(); break;
          case "notifications": loadNotifications(); break;
          case "policy-notifications": loadPolicyNotifications(); break;
          case "reminders": loadReminders(); break;
        }
      }

      // Toast notification
      function showToast(msg, type) {
        var el = document.createElement("div");
        el.className = "toast" + (type ? " " + type : "");
        el.textContent = msg;
        document.body.appendChild(el);
        setTimeout(function() { el.remove(); }, 3000);
      }

      // Format time
      function formatTime(ts) {
        if (!ts) return "";
        try {
          var d = new Date(ts);
          if (isNaN(d.getTime())) return "";
          return d.toLocaleString("zh-CN", { month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit" });
        } catch(e) { return ""; }
      }

      function loadConversations() { var ca = document.getElementById("contentArea"); if (ca) ca.innerHTML = "<div style=""padding:20px;color:#666;"">[A] Loading conversations...</div><div id=""dbg1""></div>"; var dbg = document.getElementById("dbg1"); if (dbg) dbg.innerHTML = "<div>[B] Starting fetch...</div>"; fetch("/api/message-center/conversations?hours=720").then(function(r) { if (dbg) dbg.innerHTML += "<div>[C] Response: " + r.status + "</div>"; return r.json(); }).then(function(d) { if (dbg) dbg.innerHTML += "<div>[D] JSON parsed, length: " + (d.data ? d.data.length : 0) + "</div>"; var ca = document.getElementById("contentArea"); if (!ca) return; if (d.success && d.data && d.data.length > 0) { var h = "<div style=""padding:16px;""><h3>Session Records (" + d.data.length + ")</h3>"; d.data.slice(0, 5).forEach(function(c) { h += "<div style=""padding:12px;border-bottom:1px solid #eee;""><b>" + (c.customer_name || "Unknown") + "</b><br><small>" + (c.platform || "") + " | " + (c.created_at || "") + "</small></div>"; }); h += "</div>"; ca.innerHTML = h; } else { ca.innerHTML = "<div style=""padding:20px;color:#999;"">No records</div>"; } }).catch(function(e) { if (dbg) dbg.innerHTML += "<div style=""color:red;"">[E] Error: " + e.message + "</div>"; }); }


      // Initialize
      (function() {
        var ca = document.getElementById("contentArea");
        if (ca) ca.innerHTML = '<div style="padding:40px;text-align:center;color:#666;">正在加载消息中心...</div>';
        setTimeout(function() { loadConversations(); }, 100);
      })();
    </script>
  </body>
</html>

        <div class="content" id="contentArea">
          <!-- 内容将根据 tab 动态加入 -->
          <div style="display:flex;align-items:center;justify-content:center;min-height:400px;">
            <div style="text-align:center;color:#999;">
              <div style="font-size:14px;">正在加载消息中心...</div>
            </div>
